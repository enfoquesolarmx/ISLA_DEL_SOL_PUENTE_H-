	(text "E · BOOTSTRAP DEL CANAL ALTO (dominio HV: VB1, VS1)"
		(exclude_from_sim no)
		(at 120.65 107.95 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
