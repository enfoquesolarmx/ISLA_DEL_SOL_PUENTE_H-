	(text "B · ALIMENTACIÓN 15 V DEL DRIVER (VCC)"
		(exclude_from_sim no)
		(at 100.33 13.97 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a5669890-156e-41b4-8184-9363788caeb7")
	)
	(text "C1 10 µF + C4 1 µF X7R: pegados a los pines 5 (VCC) y 3 (COM).\nC3: electrolítico de respaldo de la línea de 15 V.\n15 V y no 12 V: más V_GS (menor R_DS(on)) y más margen\nsobre el UVLO del bootstrap en la rama de 60 Hz.\nVCC del IRS2186: 10–20 V. V_GS del MOSFET: ±20 V.\nPWR_FLAG: solo para el ERC (no va al PCB)."
		(exclude_from_sim no)
		(at 101.6 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c8f9dc0-a589-439f-83e5-4bff513e7c41")
	)
